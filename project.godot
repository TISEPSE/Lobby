; Configuration du projet Interface Console
; Généré et maintenu à la main : voir CLAUDE.md

config_version=5

[application]

config/name="Interface Console"
config/description="Interface de type console (10-foot UI) pilotée à la manette."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

GameLibrary="*res://scripts/autoload/game_library.gd"
Launcher="*res://scripts/autoload/launcher.gd"
InputManager="*res://scripts/autoload/input_manager.gd"
Settings="*res://scripts/autoload/settings.gd"
CoverFetcher="*res://scripts/autoload/cover_fetcher.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=3
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[gui]

theme/default_font_multichannel_signed_distance_field=true

